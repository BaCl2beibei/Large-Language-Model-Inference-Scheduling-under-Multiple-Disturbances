+async def _real_metrics_abort_confirmed(request_id: str) -> bool:
+    # The legacy client.abort swallows RPC errors, so its return is not an ack.
+    instance_ids, instances = llumnix_client._get_instance_for_abort(request_id)
+    if not instance_ids or len(instance_ids) != len(instances):
+        return False
+    for instance in instances:
+        await asyncio_wait_for_ray_remote_call_with_timeout(instance.abort, request_id, timeout=50.0)
+    llumnix_client._clear_client_request_states(request_id)
+    return True
+
+
+install_real_metrics_routes(app, lambda: llumnix_client, SamplingParams,
+                            emit_causal_event, flush_causal_events, _real_metrics_abort_confirmed)
