+        elif mode=='overhead':cases=[(f'overhead_{i}',cfg['smoke']['overhead'],'stay' if not enabled else 'shadow',enabled)
+                                    for i,enabled in enumerate((False,True,True,False))]
+        else:cases=[(mode,cfg['smoke'][mode],mode,True)]
