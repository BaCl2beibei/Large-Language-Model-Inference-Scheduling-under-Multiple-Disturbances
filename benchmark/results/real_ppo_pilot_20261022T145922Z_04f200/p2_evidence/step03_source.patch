+        checks={'episodes_reconciled':bool(status)}
+        if stage=='telemetry':
+            checks['low_load_normal_completion']=all(row['result']['score']['fixed']['completed']>0
+                and row['result']['score']['fixed']['completed']==row['result']['score']['fixed']['offered']
